<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy to ~/Library/LaunchAgents/, replace ABSOLUTE_PATH_TO_REPO, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.spusdg-monitor.plist
     Stop/uninstall with:
       launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.example.spusdg-monitor.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.spusdg-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>ABSOLUTE_PATH_TO_REPO/scripts/monitor.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>ABSOLUTE_PATH_TO_REPO/scripts/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>ABSOLUTE_PATH_TO_REPO/scripts/launchd.err</string>
</dict>
</plist>
