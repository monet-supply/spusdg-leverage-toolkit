# Copy to .env and fill in. .env is gitignored — never commit it.

# Robinhood Chain RPC. NOTE: an Alchemy/Infura URL embeds your API key — keep it secret.
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# The wallet that owns the Morpho position (position owner / signer).
WALLET=0xYourWalletAddress

# Your deployed Looper contract (combined flash-loan lever/delever helper).
LOOPER=0xYourDeployedLooperAddress

# Foundry keystore used for signing — keep these files OUTSIDE the repo.
KEYSTORE=/absolute/path/to/keystore-json
KEYSTORE_PASSWORD_FILE=/absolute/path/to/password-file

# Where the monitor writes roe.log / lock (defaults to the scripts/ dir if unset).
LOG_DIR=/absolute/path/to/writable/log/dir
